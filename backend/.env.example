# 本機開發用。Spring Boot 不會自動讀 .env，請以 IDE 或 shell 匯出環境變數
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/read_footprints
MONGODB_DATABASE=read_footprints
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
ADMIN_EMAIL=you@gmail.com
JWT_SECRET=至少32字元的隨機字串
CORS_ALLOWED_ORIGIN=http://localhost:5173
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173

# 匯入 1.0 資料時才需要（1.0 的 Atlas 連線字串，資料庫固定讀 book_admin）
LEGACY_MONGODB_URI=
